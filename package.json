{
  "type": "module",
  "scripts": {
    "asset:resize": "node scripts/resize-game-asset.mjs",
    "asset:trim": "node scripts/crop-transparent.mjs",
    "asset:validate": "node scripts/validate-asset-names.mjs",
    "asset:webp": "node scripts/png-to-webp.mjs",
    "dev": "pnpm run dev:live",
    "dev:live": "vp dev --config vite.game.config.ts",
    "dev:editor": "vp dev --config vite.editor.config.ts",
    "dev:review": "vp dev --config vite.review.config.ts",
    "dev:vt": "node tools/run-review-stack.mjs",
    "review:server": "node tools/review-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run build:live && pnpm run build:editor",
    "build:live": "vp build --config vite.game.config.ts",
    "build:editor": "vp build --config vite.editor.config.ts",
    "check:develop": "node scripts/assert-developable.mjs",
    "deploy": "pnpm run check:develop && pnpm run typecheck && pnpm run deploy:live && pnpm run deploy:editor",
    "deploy:live": "pnpm run check:develop && pnpm run build:live && vercel deploy dist/game --prod --yes --project game-live --scope jeong-raes-projects",
    "deploy:editor": "pnpm run check:develop && pnpm run build:editor && vercel deploy dist/editor --prod --yes --project game-editor --scope jeong-raes-projects",
    "test": "vp test",
    "test:run": "vp test run",
    "prepare": "pnpm run asset:validate && vp config"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vercel": "^59.1.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.32.1",
      "onFail": "download"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
