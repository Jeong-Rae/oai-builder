{
  "type": "module",
  "scripts": {
    "asset:resize": "node scripts/resize-game-asset.mjs",
    "dev": "npm run dev:game",
    "dev:game": "vite --config vite.game.config.ts",
    "dev:editor": "vite --config vite.editor.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:game && npm run build:editor",
    "build:game": "vite build --config vite.game.config.ts",
    "build:editor": "vite build --config vite.editor.config.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "zustand": "^5.0.15"
  }
}
